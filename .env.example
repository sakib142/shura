# Model vendors. At least two are required: the invariant needs a producer
# and a verifier on different vendors, and a same-vendor pair is refused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional third vendor. Lets `forge eval` compare pairs rather than report one number.
GOOGLE_API_KEY=

# Optional local/self-hosted, OpenAI-compatible endpoint (vLLM, Ollama).
LOCAL_BASE_URL=
LOCAL_API_KEY=

DATABASE_URL=postgres://forge:forge@localhost:5440/forge

# Optional: a git binary to use. Resolved automatically if unset.
# Needed on macOS when a damaged Xcode toolchain breaks /usr/bin/git.
FORGE_GIT=
